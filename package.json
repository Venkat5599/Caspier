{
  "name": "agent-fabric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Fabric — permissioned execution layer for AI agents. Scoped session keys, x402 metering, and SKILL.md served as live REST + MCP endpoints.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "bun --filter @fabric/web dev",
    "web:build": "bun --filter @fabric/web build",
    "gateway:dev": "bun --filter @fabric/gateway dev",
    "mcp:dev": "bun --filter @fabric/mcp-server dev",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test"
  }
}
