# Kairos — edge reverse proxy (auto-TLS via Caddy).
# Web UI is on Vercel. VPS serves the API only.
#
# DNS:
#   api.kairos.dev  A  -> VPS_IP
#
# Run: caddy run --config infra/caddy/Caddyfile --envfile .env

{$API_DOMAIN:api.localhost} {
	encode gzip
	reverse_proxy 127.0.0.1:{$GATEWAY_PORT:8080}
}

