# Caspier — edge reverse proxy (auto-TLS via Caddy).
# Web UI is on Vercel (caspier.vercel.app). VPS serves API + n8n only.
#
# DNS:
#   api.caspier.dev  A  -> VPS_IP
#   n8n.caspier.dev  A  -> VPS_IP
#
# Run: caddy run --config infra/caddy/Caddyfile --envfile .env

{$API_DOMAIN:api.localhost} {
	encode gzip
	reverse_proxy 127.0.0.1:{$GATEWAY_PORT:8080}
}

{$N8N_DOMAIN:n8n.localhost} {
	encode gzip
	reverse_proxy 127.0.0.1:{$N8N_PROXY_PORT:8089}
}
