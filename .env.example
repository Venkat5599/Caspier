# Agent Fabric — environment template. Copy to .env (never commit .env).

# --- Edge ---
APP_DIR=/opt/agent-fabric
FABRIC_DOMAIN=localhost
GATEWAY_PORT=8080
WEB_PORT=8087
GATEWAY_PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# --- Data plane ---
POSTGRES_PASSWORD=fabric
DATABASE_URL=postgres://fabric:fabric@localhost:5432/fabric
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# --- Ethereum Sepolia (iExec Nox — WTF hackathon) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111
DEPLOYER_PRIVATE_KEY=
VAULT_CONTRACT_ADDRESS=
NOX_COMPUTE_SEPOLIA=0x24ef36ec5b626d7dcd09a98f3083c2758f0f77bf
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_VAULT_ADDRESS=

# --- Sepolia chain worker (optional — demo mode when unset) ---
SEPOLIA_PUBLIC_KEY=
SEPOLIA_EXPLORER_BASE=https://sepolia.etherscan.io/tx/
EVM_CHAIN_ID=11155111
EVM_NETWORK=testnet
CHAIN_WORKER_SECRET_KEY=
# Set true to force demo chain (no real ETH). Auto-enabled when no secret key.
FABRIC_DEMO_CHAIN=true

# --- Sandbox ---
SANDBOX_MAX_WALL_MS=30000
SANDBOX_MAX_MEM_MB=256


# --- AI workflow builder (optional) ---
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=deepseek/deepseek-v4-flash

# --- Safe module (WTF hackathon) ---
# Existing Safe to spend from. Leave blank to deploy standalone, then attach
# later with `bun run safe:attach` or POST /nox/safe.
SAFE_ADDRESS=

# Bearer token required by every mutating /nox route (fund, agents, settle,
# safe, epoch flush/execute). LEAVE BLANK AND THOSE ROUTES ARE OPEN TO ANYONE
# who can reach the gateway, which holds the owner key. /nox/status reports
# ownerRoutesProtected so the state is never silent.
# Note: this cannot protect owner actions from the browser dashboard, which
# would have to hold the secret. Wallet-signature auth is the real fix.
NOX_OWNER_TOKEN=
