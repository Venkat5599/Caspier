# Agent Fabric — environment template. Copy to .env (never commit .env).

# --- Edge ---
FABRIC_DOMAIN=localhost

# --- Data plane ---
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://fabric:changeme@localhost:5432/fabric
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
MINIO_USER=fabric
MINIO_PASSWORD=changemechangeme
S3_ENDPOINT=http://localhost:9000

# --- Chain / payments (x402) ---
# EVM RPC for settlement (Cronos default — confirm chain)
EVM_RPC_URL=
EVM_CHAIN_ID=
X402_FACILITATOR_URL=
# Chain worker signer key — load from Vault in prod, NEVER hardcode
CHAIN_WORKER_PRIVATE_KEY=

# --- Sandbox ---
# firecracker | gvisor | docker  (gated by VPS KVM capability — see docs/SANDBOX.md)
SANDBOX_DRIVER=gvisor
SANDBOX_MAX_WALL_MS=30000
SANDBOX_MAX_MEM_MB=256

# --- Runtime engine for skills ---
# llm | code | hybrid  (decision pending)
SKILL_RUNTIME=code

# --- AI workflow builder (aicredits, OpenAI-compatible) ---
# NEVER commit the real key — set it only in the VPS .env (chmod 600).
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=deepseek/deepseek-v4-flash
N8N_REST_URL=http://127.0.0.1:5678
GATEWAY_PUBLIC_URL=http://187.127.137.136:8086
